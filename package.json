{
  "name": "cypher-ts",
  "version": "0.1.3",
  "description": "Librería de criptografía de alto rendimiento en TypeScript puro (AES, ChaCha20, Salsa20, GCM, Poly1305)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "bun test tests/*.test.ts",
    "bench": "bun tests/benchmarks/gcm.bench.ts",
    "prepublishOnly": "npm run build && bun test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edison-manrique/cypher-ts.git"
  },
  "keywords": [
    "crypto",
    "aes",
    "chacha20",
    "salsa20",
    "gcm",
    "poly1305",
    "typescript",
    "high-performance"
  ],
  "author": "Edison Manrique",
  "license": "MIT",
  "devDependencies": {
    "@noble/ciphers": "^2.1.1",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0"
  },
  "dependencies": {}
}
